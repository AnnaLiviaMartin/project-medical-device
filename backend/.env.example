# Kopieren nach ".env" fuer lokales docker-compose, bzw. als Basis fuer
# die Container-App-Umgebungsvariablen in Azure verwenden.

# Mit `python -c "import secrets; print(secrets.token_urlsafe(50))"` erzeugen
DJANGO_SECRET_KEY=change-me-to-a-random-secret-value

DJANGO_DEBUG=False

# Kommagetrennt, ohne https://, z.B.:
# DJANGO_ALLOWED_HOSTS=medic-backend.happywater-1234abcd.germanywestcentral.azurecontainerapps.io
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Kommagetrennt, MIT https://, z.B.:
# DJANGO_CORS_ALLOWED_ORIGINS=https://medic-frontend.happywater-1234abcd.germanywestcentral.azurecontainerapps.io
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Nur noetig, wenn der Django-Admin (/admin/) genutzt wird. Kommagetrennt,
# MIT https://, gleiche Werte wie DJANGO_ALLOWED_HOSTS, nur mit Schema.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Optional: Pfad fuer die SQLite-Datei ueberschreiben, z.B. wenn ein
# persistentes Volume unter /data gemountet ist.
# DJANGO_DB_PATH=/data/db.sqlite3

# Optional: Pfad fuer Media-Uploads (Roentgenbilder, Grad-CAM-Overlays)
# ueberschreiben, z.B. wenn ein persistentes Volume unter /data gemountet ist.
# DJANGO_MEDIA_ROOT=/data/media

# Optional: Pfad zum ML-Checkpoint ueberschreiben, falls er nicht im
# Image liegt, sondern separat gemountet wird.
# ML_MODEL_PATH=/data/checkpoints/best_model.pt

# Optional: gunicorn-Tuning (Default: 1 Worker, 2 Threads, 120s Timeout -
# bewusst schlank gehalten, da bei 4 Requests/Tag Parallelitaet keine
# Rolle spielt und jeder zusaetzliche Worker das ML-Modell erneut in den
# Speicher laedt).
# GUNICORN_WORKERS=1
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=120
